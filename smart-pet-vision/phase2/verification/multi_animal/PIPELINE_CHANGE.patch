+    # --------------------------------------- opt-in multi-animal safety probe
+    def audit_additional_animals(self, im: Image.Image, primary_boxes: np.ndarray) -> dict:
+        """Reconsider a *single-animal* image with high-res and optional tiled views.
+
+        This function only proposes reasons for human referral, never asserts
+        the exact number of animals. The original detector and weights are reused.
+        """
+        image_size = (im.width, im.height)
+        proposals = []
+        settings = {'imgsz': int(self.m.review_imgsz), 'conf': float(self.m.review_conf),
+                    'iou': float(self.m.detector_iou), 'rect': False, 'verbose': False}
+        def collect(model, source, source_image, *, tile=None, override=None):
+            options = dict(settings)
+            if override:
+                options.update(override)
+            result_list = model.predict(source_image, **options)
+            if len(result_list) != 1:
+                raise ValueError('Secondary model did not return exactly one image result.')
+            result = result_list[0]
+            expected_shape = (source_image.height, source_image.width)
+            if result.boxes is None or tuple(result.orig_shape) != (expected_shape[0], expected_shape[1]):
+                raise ValueError('Secondary model has missing/misaligned boxes.')
+            boxes = result.boxes.xyxy.cpu().numpy()
+            scores = result.boxes.conf.cpu().numpy()
+            if tile is not None:
+                boxes = map_tile_boxes(boxes, tile, image_size)
+            else:
+                validate_boxes(boxes, scores, bounds=image_size)
+            proposals.append(ReviewProposal(source, boxes, scores))
+
+        collect(self.detector, 'detector_high_resolution', im)
+        if self.m.review_include_segmenter:
+            collect(self.segmenter, 'segmenter_high_resolution', im)
+        if self.m.review_tiles_enabled:
+            for idx, tile in enumerate(review_tiles(im.width, im.height)):
+                crop = im.crop(tile)
+                collect(self.detector, f'detector_tile_{idx}', crop, tile=tile,
+                        override={'imgsz': int(self.m.imgsz), 'conf': float(self.m.review_tiles_conf)})
+        cues = additional_animal_cues(primary_boxes, proposals,
+                    confidence_floor=min(self.m.review_conf, self.m.review_tiles_conf)
+                                     if self.m.review_tiles_enabled else self.m.review_conf,
+                    same_instance_iou=self.m.review_match_iou, image_size=image_size)
+        return {'status': 'evaluated', 'candidate_count': len(cues),
+                'candidates': cues, 'pass_count': len(proposals),
+                'settings': {'confidence': self.m.review_conf, 'imgsz': self.m.review_imgsz,
+                             'match_iou': self.m.review_match_iou,
+                             'include_segmenter': self.m.review_include_segmenter,
+                             'tiles_enabled': self.m.review_tiles_enabled}}
+
